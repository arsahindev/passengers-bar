---
import Icon from "./Icon.astro";
import { settings } from "../content/settings";
import { useLocale } from "../lib/i18n";
import { btnCream, field, fine } from "../lib/ui";
const { locale, tx } = useLocale(Astro.currentLocale);
const config = settings.reservations;
const label = "grid min-w-0 gap-2 text-[12px]";
---

<div class="min-w-0" data-reservation data-locale={locale} data-phone={config.phone}>
  <form novalidate>
    <fieldset
      class="m-0 grid min-w-0 grid-cols-[1fr] gap-4 border-0 p-0 min-[601px]:grid-cols-[1fr_1fr]"
      disabled
    >
      <legend class="mb-5 px-0.5 text-[1.3rem] font-semibold">
        {tx("Vaš upit za rezervaciju", "Your reservation request")}
      </legend>
      <label class={label}>
        {tx("Ime *", "Name *")}
        <input class={field} name="name" required maxlength="80" autocomplete="name" />
      </label>
      <label class={label}>
        {tx("Telefon sa pozivnim brojem države *", "Phone with country code *")}
        <input
          class={field}
          name="phone"
          type="tel"
          required
          maxlength="30"
          autocomplete="tel"
          placeholder="+381 60 123 4567"
          aria-describedby="phone-help"
        />
      </label>
      <p id="phone-help" class={`${fine} col-span-full`}>
        {tx(
          "Unesite + ili 00 i pozivni broj države, da bismo mogli da vas pozovemo.",
          "Include + or 00 and your country code so the team can call you back.",
        )}
      </p>
      <label class={label}>
        {tx("Željeni datum *", "Preferred date *")}
        <input class={field} name="date" type="date" required />
      </label>
      <label class={label}>
        {tx("Željeno vreme *", "Preferred time *")}
        <input class={field} name="time" type="time" required />
      </label>
      <label class={label}>
        {tx("Broj gostiju *", "Number of guests *")}
        <input
          class={field}
          name="guests"
          type="number"
          min="1"
          max="999"
          step="1"
          required
          inputmode="numeric"
        />
      </label>
      <label class={label}>
        {tx("Povod (opciono)", "Occasion (optional)")}
        <input class={field} name="occasion" maxlength="80" />
      </label>
      <label class={`${label} col-span-full`}>
        {tx("Posebne želje (opciono)", "Special requests (optional)")}
        <textarea class={field} name="notes" rows="3" maxlength="400"></textarea>
      </label>
      <button class={`${btnCream} col-span-full mt-[25px] w-full`} type="submit">
        {tx("Pripremite poruku", "Prepare message")}
        <Icon name="arrow-up-right" trailing />
      </button>
    </fieldset>
  </form>
  <p class={fine}>
    {tx(
      "Vreme je lokalno za Beograd. Podaci se ne čuvaju na ovom sajtu.",
      "Times are local to Belgrade. Details are not stored on this website.",
    )}
  </p>
  <div class="mt-6" data-result hidden>
    <label class={label} for="reservation-message">
      {tx("Vaša poruka", "Your message")}
    </label>
    <textarea
      class={`${field} my-2.5 resize-y`}
      id="reservation-message"
      data-message
      rows="10"
      readonly
    ></textarea>
    <p class={fine}>
      {tx(
        "Otvara vašu aplikaciju za poruke. Pritisnite „Pošalji” da pošaljete upit. Rezervacija je potvrđena tek kada dobijete potvrdu restorana.",
        "Opens your messaging app. Press Send to submit your request. Your reservation is confirmed only after the restaurant replies.",
      )}
    </p>
    <p data-apple-note hidden class={fine}>
      {tx(
        "Na iPhone-u prvo kopirajte poruku, zatim otvorite SMS i nalepite je.",
        "On iPhone, copy your message first, then open SMS and paste it.",
      )}
    </p>
    <div class="mt-[30px] flex flex-wrap gap-3">
      <button type="button" class={btnCream} data-copy>
        {tx("Kopirajte upit", "Copy request")}
      </button>
      <a class={btnCream} data-sms>
        {tx("Otvorite SMS", "Open SMS")}
        <Icon name="arrow-up-right" trailing />
      </a>
      {config.whatsapp && (
        <a class={btnCream} data-whatsapp rel="noreferrer">
          WhatsApp
          <Icon name="arrow-up-right" trailing />
        </a>
      )}
    </div>
    <p class={fine}>
      {tx(
        "Ako se aplikacija ne otvori ili poruka nije popunjena, kopirajte tekst i pošaljite ga na +381 60 646 4109. Moguća je naplata SMS-a prema vašoj tarifi.",
        "If the app does not open or the message is empty, copy the text and send it to +381 60 646 4109. Your carrier’s SMS charges may apply.",
      )}
    </p>
    {config.viber && (
      <p class={fine}>
        {tx(
          "Za Viber: kopirajte upit, otvorite Viber, pronađite +381 60 646 4109 i nalepite poruku u razgovor.",
          "For Viber: copy the request, open Viber, find +381 60 646 4109 and paste the message into the chat.",
        )}
      </p>
    )}
  </div>
  <p class="empty:hidden" data-status role="status" aria-live="polite"></p>
  <a class="mt-4 inline-block underline" href={`tel:${config.phone}`}>
    {tx("Ili nas pozovite", "Or call us")}: +381 60 646 4109
    <Icon name="arrow-up-right" trailing />
  </a>
  <noscript>
    <p>
      {tx(
        "Za pripremu poruke uključite JavaScript ili nas pozovite.",
        "Enable JavaScript to prepare a message, or call us.",
      )}
    </p>
  </noscript>
</div>
<script>
  import {
    normalizePhone,
    belgradeStamp,
    futureSlot,
    messageFor,
    smsLink,
    whatsappLink,
  } from "../lib/reservation.mjs";
  for (const widget of document.querySelectorAll<HTMLElement>("[data-reservation]")) {
    const sr = widget.dataset.locale === "sr";
    const tx = (a: string, b: string) => (sr ? a : b);
    const form = widget.querySelector("form")!;
    const fieldset = form.querySelector("fieldset")!;
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const result = widget.querySelector<HTMLElement>("[data-result]")!;
    const message = widget.querySelector<HTMLTextAreaElement>("[data-message]")!;
    const status = widget.querySelector<HTMLElement>("[data-status]")!;
    const sms = widget.querySelector<HTMLAnchorElement>("[data-sms]")!;
    const whatsapp = widget.querySelector<HTMLAnchorElement>("[data-whatsapp]");
    const phone = widget.dataset.phone!;
    const apple =
      /iPhone|iPad|iPod/.test(navigator.userAgent) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    input("date").min = belgradeStamp().slice(0, 10);
    function clear() {
      result.hidden = true;
      message.value = "";
      status.textContent = "";
      sms.removeAttribute("href");
      whatsapp?.removeAttribute("href");
      for (const name of ["name", "phone", "date"]) input(name).setCustomValidity("");
    }
    function valid() {
      input("date").min = belgradeStamp().slice(0, 10);
      input("name").setCustomValidity(
        input("name").value.trim() ? "" : tx("Unesite ime.", "Enter your name."),
      );
      input("phone").setCustomValidity(
        normalizePhone(input("phone").value)
          ? ""
          : tx(
              "Unesite međunarodni broj, npr. +381601234567.",
              "Enter an international number, e.g. +381601234567.",
            ),
      );
      input("date").setCustomValidity(
        futureSlot(input("date").value, input("time").value)
          ? ""
          : tx(
              "Izaberite važeći budući datum i vreme u Beogradu.",
              "Choose a valid future date and time in Belgrade.",
            ),
      );
      return form.reportValidity();
    }
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clear();
      if (!valid()) return;
      message.value = messageFor(Object.fromEntries(new FormData(form)), widget.dataset.locale);
      sms.href = smsLink(phone, message.value, apple);
      if (whatsapp) whatsapp.href = whatsappLink(phone, message.value);
      widget.querySelector<HTMLElement>("[data-apple-note]")!.hidden = !apple;
      result.hidden = false;
      status.textContent = tx(
        "Poruka je spremna. Još nije poslata.",
        "Message ready. It has not been sent.",
      );
      message.focus();
    });
    form.addEventListener("input", clear);
    form.addEventListener("change", clear);
    for (const link of [sms, whatsapp])
      link?.addEventListener("click", (event) => {
        if (!valid()) {
          event.preventDefault();
          clear();
          return;
        }
        status.textContent = tx(
          "Pošaljite poruku u aplikaciji, pa sačekajte odgovor restorana.",
          "Send the message in your app, then wait for the restaurant’s reply.",
        );
      });
    widget.querySelector("[data-copy]")!.addEventListener("click", async () => {
      if (!valid()) {
        clear();
        return;
      }
      try {
        await navigator.clipboard.writeText(message.value);
        status.textContent = tx(
          "Upit je kopiran. Nalepite ga u poruku i pošaljite.",
          "Request copied. Paste it into your message and send.",
        );
      } catch {
        message.focus();
        message.select();
        status.textContent = tx(
          "Tekst je označen. Kopirajte ga ručno i nalepite u poruku.",
          "Text selected. Copy it manually and paste into your message.",
        );
      }
    });
    // Without JavaScript all fields remain disabled; no guest details can become a GET URL.
    fieldset.disabled = false;
  }
</script>
