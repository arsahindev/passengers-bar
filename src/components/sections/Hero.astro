---
import Icon from "../Icon.astro";
import { useLocale } from "../../lib/i18n";
import { Image } from "astro:assets";
import { settings } from "../../content/settings";
import { actions, btnCream, eyebrow, underlined } from "../../lib/ui";
import hero from "../../assets/passengers/hero.jpg";
const { tx } = useLocale(Astro.currentLocale);
// The hero grows with its content: the copy and the bottom strip are in normal flow (not absolutely
// positioned), so a longer headline can never push the buttons onto the strip.
---

<section class="relative flex min-h-[max(73vh,580px)] flex-col justify-between gap-10 bg-espresso px-[7%] pb-[30px] pt-[max(7.3vh,58px)] text-white md:min-h-[max(min(770px,80vh),540px)] md:px-[8%] md:pt-[max(min(115px,12vh),81px)]">
  <Image
    class="absolute inset-0 h-full w-full object-cover object-center"
    src={hero}
    width={1600}
    format="webp"
    alt={tx("Bašta Passengers Bara", "Passengers Bar garden")}
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-[linear-gradient(90deg,#101910bb_0%,#10191055_58%,#10191022)]"></div>
  <div class="relative max-w-[770px] md:max-w-[1100px]">
    <p class={eyebrow}>SIMINA 5 · DORĆOL · BEOGRAD</p>
    <h1 class="text-[3.8rem] tracking-[-.045em] md:text-[clamp(4.7rem,8vw,8.5rem)]">
      {tx("Vaše mesto.", "Your kind")}
      <br />
      <em>{tx("U srcu Dorćola.", "of place.")}</em>
    </h1>
    <p class="mt-[25px] max-w-[270px] text-[14px] md:max-w-none md:text-[16px]">
      {tx(
        "Jutarnja kafa. Dugi ručkovi. Večeri koje ne planirate.",
        "Morning coffee. Long lunches. Evenings you didn’t plan.",
      )}
    </p>
    <div class={actions}>
      <a class={btnCream} href="#reserve">
        {tx("Pronađite svoje mesto", "Find your table")}
        <Icon name="arrow-up-right" trailing />
      </a>
      <a href="#tour" class={underlined}>
        {tx("Pogledajte prostor", "Explore the space")}
        <Icon name="arrow-down" trailing />
      </a>
    </div>
  </div>
  <div class="relative flex flex-wrap justify-between gap-x-6 gap-y-2 text-[8px] tracking-[.12em] md:text-[10px]">
    <span>{tx("HRANA · PIĆE · DOBRO DRUŠTVO", "FOOD · DRINKS · GOOD COMPANY")}</span>
    <span class="flex flex-wrap gap-x-[1.6em] gap-y-2">
      <span
        data-today-hours
        data-hours={JSON.stringify(
          settings.hours.map(({ days, open, close }) => ({ days, open, close })),
        )}
        data-label={tx("Danas", "Today")}
        hidden
      ></span>
      <a href={settings.mapUrl} target="_blank" rel="noopener noreferrer">
        {tx("Put do nas", "Get directions")}
        <Icon name="arrow-up-right" trailing />
      </a>
    </span>
  </div>
</section>
<script>
  // Today's opening hours (Belgrade time) in the bottom strip. Filled in on the visitor's device,
  // since a static page can't know the day; without JavaScript the strip simply omits it.
  import { belgradeWeekday, hoursOn } from "../../lib/hours.mjs";
  const today = document.querySelector<HTMLElement>("[data-today-hours]");
  if (today) {
    const hours = hoursOn(JSON.parse(today.dataset.hours || "[]"), belgradeWeekday());
    if (hours) {
      today.textContent = `${today.dataset.label} ${hours.open}–${hours.close}`;
      today.hidden = false;
    }
  }
</script>
