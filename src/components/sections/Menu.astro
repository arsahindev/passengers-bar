---
import Icon from "../Icon.astro";
import Viewer from "../Viewer.astro";
import { useLocale } from "../../lib/i18n";
import { Image, getImage } from "astro:assets";
import { actions, btnCream, eyebrow, fanPage, underlined } from "../../lib/ui";
const { locale, tx } = useLocale(Astro.currentLocale);

const menu = `/menus/passengers-menu-${locale}.pdf`;
// Page images rendered from the PDF by scripts/menu-pages.mjs (runs before dev and build).
const pages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../../assets/menus/*/*.png", { eager: true }),
)
  .filter(([path]) => path.includes(`/menus/${locale}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => image.default);
const pageLabel = (i: number) =>
  tx(`Meni, strana ${i + 1} od ${pages.length}`, `Menu, page ${i + 1} of ${pages.length}`);
// Pages for the full-screen viewer (src/scripts/menu-viewer.ts): a light version shown at once,
// then the full-size one, sharp enough to zoom on a phone.
const viewerPages = await Promise.all(
  pages.map(async (page, i) => ({
    small: (await getImage({ src: page, width: 900, format: "webp", quality: 85 })).src,
    large: (await getImage({ src: page, format: "webp", quality: 85 })).src,
    alt: pageLabel(i),
    ratio: page.width / page.height,
  })),
);
// The first three pages, fanned out like menus on a table; each opens the viewer at that page.
// Listed back to front: page 3 (right), page 2 (left), page 1 (front). Complete class literals so
// Tailwind can see them.
const fan = [
  {
    index: 2,
    position:
      "-translate-x-[18%] -translate-y-1/2 rotate-[8deg] group-hover:-translate-x-[8%] group-hover:rotate-[11deg]",
  },
  {
    index: 1,
    position:
      "-translate-x-[82%] -translate-y-1/2 -rotate-[8deg] group-hover:-translate-x-[92%] group-hover:-rotate-[11deg]",
  },
  {
    index: 0,
    position:
      "-translate-x-1/2 -translate-y-[47%] group-hover:-translate-y-[52%] group-hover:scale-[1.03]",
  },
].filter(({ index }) => pages[index]);
---

<section class="grid grid-cols-[1fr] bg-wine text-cream md:grid-cols-[1fr_1fr]" id="menu">
  <div class="px-[7%] pb-[10px] pt-[50px] md:self-center md:px-[16%] md:py-[85px]">
    <p class={eyebrow}>{tx("DOBRO JUTRO. DOBAR APETIT.", "GOOD MORNINGS. GOOD APPETITES.")}</p>
    <h2>{tx("Za svaki deo dana.", "Something for every part of the day.")}</h2>
    <p class="mt-6">
      {tx(
        "Pogledajte meni i pronađite svoj sledeći razlog za dolazak.",
        "Browse the menu and find your next reason to visit.",
      )}
    </p>
    <div class={actions}>
      <button class={btnCream} type="button" data-viewer-for="menu" data-viewer-open="0">
        {tx("Pogledajte meni", "Browse the menu")}
        <Icon name="arrow-right" trailing />
      </button>
      <a class={underlined} href={menu} download>
        {tx("Preuzmite PDF", "Download PDF")}
        <Icon name="arrow-down" trailing />
      </a>
    </div>
  </div>
  <div class="group relative h-[clamp(330px,100vw,460px)] overflow-hidden md:h-auto md:min-h-[620px]">
    {fan.map(({ index, position }) => (
      <button
        class={`${fanPage} ${position}`}
        type="button"
        data-viewer-for="menu"
        data-viewer-open={index}
        aria-label={tx(`Otvorite stranu ${index + 1}`, `Open page ${index + 1}`)}
      >
        <Image
          class="block h-auto w-full"
          src={pages[index]}
          widths={[300, 450, 600, 900]}
          sizes="(min-width: 761px) 300px, 46vw"
          format="webp"
          quality={85}
          loading="lazy"
          alt=""
        />
      </button>
    ))}
  </div>
  <Viewer name="menu" pages={viewerPages} label={tx("Meni", "Menu")} />
</section>
