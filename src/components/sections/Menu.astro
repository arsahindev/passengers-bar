---
import Icon from "../Icon.astro";
import { useLocale } from "../../lib/i18n";
import { Image } from "astro:assets";
import { btnCream, eyebrow } from "../../lib/ui";
import food1 from "../../assets/passengers/food-1.jpg";
const { sr, tx } = useLocale(Astro.currentLocale);

const menu = `/menus/passengers-menu-${sr ? "sr" : "en"}.pdf`;
---

<section
  class="grid grid-cols-[1fr] gap-[30px] bg-wine text-cream md:grid-cols-[1fr_1fr] md:gap-0"
  id="menu"
>
  <div class="px-[7%] py-[50px] md:px-[16%] md:py-[85px]">
    <p class={eyebrow}>{tx("DOBRO JUTRO. DOBAR APETIT.", "GOOD MORNINGS. GOOD APPETITES.")}</p>
    <h2>{tx("Za svaki deo dana.", "Something for every part of the day.")}</h2>
    <p class="mt-6">
      {tx(
        "Pogledajte meni i pronađite svoj sledeći razlog za dolazak.",
        "Browse the menu and find your next reason to visit.",
      )}
    </p>
    <a class={`${btnCream} mt-[25px]`} href={menu} target="_blank" rel="noopener noreferrer">
      {tx("Otvorite meni · PDF", "Open menu · PDF")}
      <Icon name="arrow-up-right" trailing />
    </a>
  </div>
  <Image
    class="h-80 max-h-[660px] w-full object-cover md:h-full"
    src={food1}
    width={850}
    format="webp"
    loading="lazy"
    alt={tx("Jelo iz Passengers Bara", "A dish at Passengers Bar")}
  />
</section>
<section
  class="bg-wine px-[max(6vw,20px)] py-6 text-cream"
  aria-label={tx("Pregled menija", "Menu viewer")}
>
  <details class="mx-auto max-w-[1280px]">
    <summary class="cursor-pointer py-3 text-[1.1rem]">
      {tx("Pročitajte meni ovde", "Read the menu here")}
      <span class="float-right" aria-hidden="true">
        <Icon name="plus" />
      </span>
    </summary>
    <p>
      <a class="underline" href={menu} target="_blank" rel="noopener noreferrer">
        {tx("Otvorite PDF u novom prozoru", "Open the PDF in a new tab")}
        <Icon name="arrow-up-right" trailing />
      </a>
    </p>
    <iframe
      class="block h-[min(80vh,900px)] min-h-[400px] w-full rounded-lg border-0 bg-cream"
      src={menu}
      title={tx("Passengers Bar - meni na srpskom", "Passengers Bar - English menu")}
      loading="lazy"
    ></iframe>
  </details>
</section>
