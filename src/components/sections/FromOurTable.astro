---
import Icon from "../Icon.astro";
import { useLocale } from "../../lib/i18n";
import { Image } from "astro:assets";
import { btnCream, eyebrow } from "../../lib/ui";
import food1 from "../../assets/passengers/food-1.jpg";
const { tx } = useLocale(Astro.currentLocale);
// Full-width food photograph between the menu and celebrations, with a nudge to book a table.
// The photo is portrait, so the band shows a slice centred on the plate.
---

<section class="relative isolate flex min-h-[max(60vh,420px)] items-end overflow-hidden bg-espresso px-[7%] py-[45px] text-white md:min-h-[min(680px,75vh)] md:px-[8%] md:py-[70px]">
  <Image
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_45%]"
    src={food1}
    widths={[800, 1200, 1600, 2000]}
    sizes="100vw"
    format="webp"
    loading="lazy"
    alt={tx("Jelo iz Passengers Bara", "A dish at Passengers Bar")}
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,#101910cc_0%,#10191033_50%,#10191000_75%)]"></div>
  <div>
    <p class={eyebrow}>{tx("SA NAŠEG STOLA", "FROM OUR TABLE")}</p>
    <a class={btnCream} href="#reserve">
      {tx("Pronađite svoje mesto", "Find your table")}
      <Icon name="arrow-up-right" trailing />
    </a>
  </div>
</section>
