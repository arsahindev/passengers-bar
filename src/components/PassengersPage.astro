---
import ReservationForm from "./ReservationForm.astro";
import { Image } from "astro:assets";
import { settings } from "../content/settings";
import {
  actions,
  btn,
  btnCream,
  btnSmall,
  eyebrow,
  section,
  sectionHead,
  twoColumns,
  underlined,
  wordmark,
  wordmarkSub,
} from "../lib/ui";
import "../styles/global.css";
import logo from "../assets/passengers/logo.png";
import hero from "../assets/passengers/hero.jpg";
import room1 from "../assets/passengers/space-1.jpg";
import room2 from "../assets/passengers/space-2.jpg";
import room3 from "../assets/passengers/space-3.jpg";
import food1 from "../assets/passengers/food-1.jpg";
import food2 from "../assets/passengers/food-2.jpg";
import breakfastEN from "../assets/passengers/breakfast-en.png";
import breakfastSR from "../assets/passengers/breakfast-sr.jpg";
import offersEN from "../assets/passengers/offers-en.png";
import offersSR from "../assets/passengers/offers-sr.jpg";

const { locale = "en" } = Astro.props;
const sr = locale === "sr";
const tx = (serbian: string, english: string) => (sr ? serbian : english);

const gallery = [room1, room2, room3, food1, food2];
const menu = `/menus/passengers-menu-${sr ? "sr" : "en"}.pdf`;
const map =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent("Passengers Bar Simina 5 Belgrade");
---

<!doctype html>
<html lang={sr ? "sr-Latn" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#53272e" />
    <title>
      {tx("Passengers Bar", "Passengers Bar")}
    </title>
    <meta
      name="description"
      content={tx(
        "Passengers Bar u srcu Dorćola. Istražite prostor, pogledajte meni i kontaktirajte nas za rezervacije i proslave.",
        "Passengers Bar in the heart of Dorćol. Explore the space, browse the menu and get in touch for tables and celebrations.",
      )}
    />
  </head>
  <body data-locale={locale}>
    <a class="absolute left-2.5 top-[-80px] z-[100] bg-white p-2.5 focus:top-0" href="#main">
      {tx("Pređi na sadržaj", "Skip to content")}
    </a>
    <header class="flex flex-wrap items-center justify-between gap-2.5 bg-cream px-[6%] py-[15px] md:flex-nowrap md:gap-6 md:px-[5%] md:py-4">
      <a class={wordmark} href="#main">
        <Image
          class="h-[46px] w-[46px] md:h-[66px] md:w-[66px]"
          src={logo}
          width={66}
          height={66}
          alt="Passengers Bar"
        />
        <span>
          PASSENGERS<small class={wordmarkSub}>BAR · DORĆOL</small>
        </span>
      </a>
      <nav
        class="flex w-full items-center justify-between gap-[17px] text-[11px] md:w-auto md:justify-start md:gap-7 md:text-[13px]"
        aria-label={tx("Glavna navigacija", "Main navigation")}
      >
        <a class="max-md:hidden hover:underline" href="#story">
          {tx("Naše mesto", "Our place")}
        </a>
        <a class="hover:underline" href="#menu">
          {tx("Meni", "Menu")}
        </a>
        <a class="hover:underline" href="#celebrate">
          {tx("Proslave", "Celebrations")}
        </a>
        <a class="font-bold hover:underline" href={"/" + (sr ? "en" : "sr") + "/"}>
          {sr ? "EN" : "SR"}
        </a>
        <a class={btnSmall} href="#reserve">
          {tx("Rezervacije", "Reservations")}↗
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="relative h-[73vh] min-h-[580px] bg-espresso text-white md:h-[min(770px,80vh)] md:min-h-[540px]">
        <Image
          class="h-full w-full object-cover object-center"
          src={hero}
          width={1600}
          format="webp"
          alt={tx("Bašta Passengers Bara", "Passengers Bar garden")}
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,#101910bb_0%,#10191055_58%,#10191022)]"></div>
        <div class="absolute left-[7%] right-[7%] top-[10%] max-w-[770px] md:left-[8%] md:right-auto md:top-[15%]">
          <p class={eyebrow}>SIMINA 5 · DORĆOL · BEOGRAD</p>
          <h1 class="text-[3.8rem] tracking-[-.045em] md:text-[clamp(4.7rem,8vw,8.5rem)]">
            {tx("Vaše mesto.", "Your kind")}
            <br />
            <em>{tx("U srcu Dorćola.", "of place.")}</em>
          </h1>
          <p class="mt-[25px] max-w-[270px] text-[14px] md:max-w-none md:text-[16px]">
            {tx(
              "Jutarnja kafa. Dugi ručkovi. Večeri koje ne planirate.",
              "Morning coffee. Long lunches. Evenings you didn’t plan.",
            )}
          </p>
          <div class={actions}>
            <a class={btnCream} href="#reserve">
              {tx("Pronađite svoje mesto", "Find your table")}↗
            </a>
            <a href="#tour" class={underlined}>
              {tx("Pogledajte prostor", "Explore the space")}↓
            </a>
          </div>
        </div>
        <div class="absolute bottom-[30px] left-[7%] right-[7%] flex justify-between text-[8px] tracking-[.12em] md:left-[8%] md:right-[8%] md:text-[10px]">
          <span>{tx("HRANA · PIĆE · DOBRO DRUŠTVO", "FOOD · DRINKS · GOOD COMPANY")}</span>
          <a href={map} target="_blank" rel="noopener noreferrer">
            {tx("Put do nas", "Get directions")}↗
          </a>
        </div>
      </section>
      <section id="story" class={`${section} ${twoColumns}`}>
        <div>
          <p class={eyebrow}>{tx("MALO DALJE OD ŽURBE", "A LITTLE AWAY FROM THE RUSH")}</p>
          <h2>
            {tx("U centru grada.", "Right in the city.")}
            <br />
            <em>{tx("U svom ritmu.", "At your own pace.")}</em>
          </h2>
        </div>
        <div>
          <p class="text-[18px] leading-[1.65] md:text-[20px]">
            {tx(
              "Na uglu Simine i Višnjićeve, Passengers spaja druženje, hranu i baštu u kojoj se ostaje malo duže.",
              "On the corner of Simina and Višnjićeva, Passengers brings together food, conversation and a garden made for staying a little longer.",
            )}
          </p>
          <p>
            {tx(
              "Svratite na kafu, okupite prijatelje za ručak ili nam se javite da zajedno osmislimo proslavu.",
              "Drop in for coffee, gather your friends for lunch, or talk to us about your next celebration.",
            )}
          </p>
          <a class={`${underlined} mt-6 inline-block`} href="#gallery">
            {tx("Zavirite unutra", "Take a look around")}↗
          </a>
        </div>
      </section>
      <section
        class="mx-auto max-w-[1400px] px-[7%] py-[55px] md:px-[8%] md:pb-[95px] md:pt-2.5"
        id="gallery"
      >
        <div class={`${sectionHead} flex`}>
          <div>
            <p class={eyebrow}>{tx("MESTO I TRENUTAK", "THE PLACE. THE MOMENT.")}</p>
            <h2 class="text-[2.6rem] md:text-[clamp(2.5rem,4vw,4.2rem)]">
              {tx("Osetite Passengers.", "A taste of Passengers.")}
            </h2>
          </div>
          <div class="flex gap-2.5 self-end md:self-auto">
            <button
              class="size-[35px] rounded-full border border-[#b5b4a8] bg-transparent text-[22px] md:size-11"
              type="button"
              data-gallery-prev
              aria-label={tx("Prethodna fotografija", "Previous photograph")}
            >
              ←
            </button>
            <button
              class="size-[35px] rounded-full border border-[#b5b4a8] bg-transparent text-[22px] md:size-11"
              type="button"
              data-gallery-next
              aria-label={tx("Sledeća fotografija", "Next photograph")}
            >
              →
            </button>
          </div>
        </div>
        <div
          class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-[15px]"
          tabindex="0"
          data-gallery
          aria-label={tx("Galerija fotografija", "Photo gallery")}
        >
          {gallery.map((img, i) => (
            <figure class="shrink-0 grow-0 basis-[85%] snap-start md:basis-[42%]">
              <>
                <Image
                  class="h-[330px] w-full object-cover md:h-[380px]"
                  src={img}
                  width={850}
                  format="webp"
                  loading="lazy"
                  alt={tx(
                    i < 3 ? "Ambijent Passengers Bara" : "Hrana u Passengers Baru",
                    i < 3 ? "The setting at Passengers Bar" : "Food at Passengers Bar",
                  )}
                />
                <figcaption class="mt-[15px] text-[10px] tracking-[.15em]">
                  {String(i + 1).padStart(2, "0")} / 05 ·{" "}
                  {tx(
                    i < 3 ? "Naš prostor" : "Sa našeg stola",
                    i < 3 ? "Our space" : "From our table",
                  )}
                </figcaption>
              </>
            </figure>
          ))}
        </div>
      </section>
      <section
        class="grid grid-cols-[1fr] gap-[30px] bg-wine text-cream md:grid-cols-[1fr_1fr] md:gap-0"
        id="menu"
      >
        <div class="px-[7%] py-[50px] md:px-[16%] md:py-[85px]">
          <p class={eyebrow}>
            {tx("DOBRO JUTRO. DOBAR APETIT.", "GOOD MORNINGS. GOOD APPETITES.")}
          </p>
          <h2>{tx("Za svaki deo dana.", "Something for every part of the day.")}</h2>
          <p class="mt-6">
            {tx(
              "Pogledajte meni i pronađite svoj sledeći razlog za dolazak.",
              "Browse the menu and find your next reason to visit.",
            )}
          </p>
          <a class={`${btnCream} mt-[25px]`} href={menu} target="_blank" rel="noopener noreferrer">
            {tx("Otvorite meni · PDF", "Open menu · PDF")}↗
          </a>
        </div>
        <Image
          class="h-80 max-h-[660px] w-full object-cover md:h-full"
          src={food1}
          width={850}
          format="webp"
          loading="lazy"
          alt={tx("Jelo iz Passengers Bara", "A dish at Passengers Bar")}
        />
      </section>
      <section
        class="bg-wine px-[max(6vw,20px)] py-6 text-cream"
        aria-label={tx("Pregled menija", "Menu viewer")}
      >
        <details class="mx-auto max-w-[1280px]">
          <summary class="cursor-pointer py-3 text-[1.1rem]">
            {tx("Pročitajte meni ovde", "Read the menu here")}
            <span class="float-right" aria-hidden="true">
              ＋
            </span>
          </summary>
          <p>
            <a class="underline" href={menu} target="_blank" rel="noopener noreferrer">
              {tx("Otvorite PDF u novom prozoru", "Open the PDF in a new tab")}↗
            </a>
          </p>
          <iframe
            class="block h-[min(80vh,900px)] min-h-[400px] w-full rounded-lg border-0 bg-cream"
            src={menu}
            title={tx("Passengers Bar - meni na srpskom", "Passengers Bar - English menu")}
            loading="lazy"
          ></iframe>
        </details>
      </section>
      <section id="celebrate" class={`${section} ${twoColumns}`}>
        <div>
          <Image
            class="h-[390px] w-full object-cover md:h-[570px]"
            src={room2}
            width={850}
            format="webp"
            loading="lazy"
            alt={tx("Ambijent Passengers Bara", "Passengers Bar interior")}
          />
        </div>
        <div>
          <p class={eyebrow}>{tx("VAŠ POVOD. NAŠ PROSTOR.", "YOUR OCCASION. OUR PLACE.")}</p>
          <h2>
            {tx("Okupite", "Bring everyone")}
            <br />
            <em>{tx("svoje ljude.", "together.")}</em>
          </h2>
          <p class="mt-[25px]">
            {tx(
              "Rođendan, privatno okupljanje ili poslovni događaj. Recite nam šta planirate i kakav ambijent želite.",
              "A birthday, a private gathering or a work event. Tell us what you’re planning and the atmosphere you have in mind.",
            )}
          </p>
          <div class="mb-[30px] mt-[25px] flex flex-wrap gap-2.5">
            <span class="border border-[#d5d0c4] px-3 py-2 text-[11px]">
              {tx("Privatni događaji", "Private events")}
            </span>
            <span class="border border-[#d5d0c4] px-3 py-2 text-[11px]">
              {tx("Prostor uz baštu", "Garden-side setting")}
            </span>
            <span class="border border-[#d5d0c4] px-3 py-2 text-[11px]">
              {tx("Dogovor prema povodu", "Plans tailored to the occasion")}
            </span>
          </div>
          <a class={btn} href="#reserve" data-event-link>
            {tx("Upit za proslavu", "Plan a celebration")}↗
          </a>
        </div>
      </section>
      {settings.tourEmbedUrl && (
        <section class="bg-mist px-[7%] py-[55px] md:px-[8%] md:py-[85px]" id="tour">
          <div class={`${sectionHead} md:mx-auto md:flex md:max-w-[1150px]`}>
            <div>
              <p class={eyebrow}>
                360°{settings.tourIsSample ? tx(" · Primer ture", " · Sample tour") : ""}
              </p>
              <h2>{tx("Pogledajte prostor.", "Take a look around.")}</h2>
            </div>
            <p class="md:max-w-[340px]">
              {tx(
                "Pronađite svoj omiljeni kutak pre dolaska.",
                "Find your favourite corner before you visit.",
              )}
            </p>
          </div>
          <iframe
            class="inline border-2 align-baseline [border-style:inset]"
            src={settings.tourEmbedUrl}
            title={
              settings.tourIsSample
                ? tx("Primer virtuelne ture stana", "Sample apartment virtual tour")
                : tx("Virtuelna tura Passengers Bara", "Passengers Bar virtual tour")
            }
            width="100%"
            height="500"
            loading="lazy"
            allow="autoplay; fullscreen; gyroscope; accelerometer; xr-spatial-tracking"
            allowfullscreen
          ></iframe>
        </section>
      )}
      <section class={section} id="offers">
        <div class={`${sectionHead} md:flex`}>
          <div>
            <p class={eyebrow}>{tx("AKTUELNO", "WHAT’S ON")}</p>
            <h2>{tx("Mali razlozi za dolazak.", "A few more reasons to visit.")}</h2>
          </div>
          <p class="mt-[18px]! text-[11px] leading-[1.7] opacity-75 md:max-w-[340px]">
            {tx(
              "Za aktuelne ponude i uslove obratite se našem timu.",
              "Ask our team about current offers and availability.",
            )}
          </p>
        </div>
        <div class="grid grid-cols-[1fr] gap-[30px] md:grid-cols-[1fr_1fr]">
          <figure>
            <Image
              class="h-auto w-full"
              src={sr ? breakfastSR : breakfastEN}
              width={1100}
              format="webp"
              loading="lazy"
              alt={tx(
                "Doručak: uz doplatu od 250 RSD kafa i ceđeni miks uz bilo koji doručak. Proverite aktuelnu ponudu sa osobljem.",
                "Breakfast: add coffee and freshly squeezed mixed juice for RSD 250. Offer subject to confirmation.",
              )}
            />
            <figcaption class="mt-3 text-[11px]">{tx("Doručak", "Breakfast")}</figcaption>
          </figure>
          <figure>
            <Image
              class="h-auto w-full"
              src={sr ? offersSR : offersEN}
              width={1100}
              format="webp"
              loading="lazy"
              alt={tx(
                "Akcije: 4+1 burger gratis; nedelja–četvrtak 25% na određena pića; uz ručak 14–16h jedno piće po izboru. Proverite uslove sa osobljem.",
                "Offers: buy four burgers, get one free; Sunday–Thursday 25% off selected drinks; lunch 14–16 includes a drink from the listed selection. Terms subject to confirmation.",
              )}
            />
            <figcaption class="mt-3 text-[11px]">{tx("Ponude", "Offers")}</figcaption>
          </figure>
        </div>
      </section>
      <section
        class="grid grid-cols-[1fr] gap-[30px] bg-forest px-[7%] py-[55px] text-white md:grid-cols-[1fr_1fr] md:gap-20 md:px-[8%] md:py-[90px]"
        id="reserve"
      >
        <div class="*:mt-5 *:max-w-[400px] md:*:mt-[30px]">
          <p class={eyebrow}>{tx("NAPRAVITE PLAN", "MAKE A PLAN")}</p>
          <h2 class="mt-0! max-w-none! text-[3.5rem] md:text-[clamp(2.5rem,4vw,4.2rem)]">
            {tx("Vidimo se", "See you")}
            <br />
            <em>{tx("za stolom.", "at the table.")}</em>
          </h2>
          <p>
            {tx(
              "Planirate dolazak ili proslavu? Javite nam željeni datum, vreme i broj gostiju.",
              "Planning a visit or a celebration? Tell us your preferred date, time and number of guests.",
            )}
          </p>
        </div>
        <div>
          <ReservationForm locale={locale} />
        </div>
      </section>
      <section id="visit" class={`${section} ${twoColumns}`}>
        <div>
          <p class={eyebrow}>{tx("DORĆOL VAS ČEKA", "DORĆOL IS CALLING")}</p>
          <h2>
            Simina 5.
            <br />
            <em>{tx("Svratite.", "Come by.")}</em>
          </h2>
          <p class="mt-[25px]">Simina 5, Beograd</p>
          <p>
            {tx("Pon–čet", "Mon–Thu")}08:30–00:00
            <br />
            {tx("Pet–sub", "Fri–Sat")}08:30–01:00
            <br />
            {tx("Nedelja", "Sunday")}09:00–00:00
          </p>
          <div class={actions}>
            <a class={btn} href={map} target="_blank" rel="noopener noreferrer">
              Google Maps ↗
            </a>
            <a
              class={underlined}
              href="https://www.instagram.com/passengers_bar/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram ↗
            </a>
          </div>
        </div>
        <div class="relative flex min-h-[320px] flex-col justify-end bg-sand p-[30px] md:min-h-[390px] md:p-[45px]">
          <span
            class="absolute right-[35px] top-5 font-[Georgia,serif] text-[95px] text-wine"
            aria-hidden="true"
          >
            ↗
          </span>
          <p class={eyebrow}>SIMINA × VIŠNJIĆEVA</p>
          <h3 class="text-[40px]">
            {tx("Na uglu.", "On the corner.")}
            <br />
            {tx("U komšiluku.", "In the neighbourhood.")}
          </h3>
          <a
            class="mt-7 text-[12px] underline"
            href={map}
            target="_blank"
            rel="noopener noreferrer"
          >
            {tx("Otvorite tačnu lokaciju u Google Maps", "Open the location in Google Maps")}↗
          </a>
        </div>
      </section>
    </main>
    <footer class="flex items-start justify-between gap-5 border-t border-[#d9d4c9] px-[7%] py-[30px] md:items-center md:gap-0 md:px-[8%] md:py-10">
      <div class={wordmark}>
        PASSENGERS<small class={wordmarkSub}>BAR · DORĆOL</small>
      </div>
      <p class="text-right text-[11px]">
        {tx("Simina 5 · Dorćol · Beograd", "Simina 5 · Dorćol · Belgrade")}
        <br />
        <a class="underline" href={settings.origin + "/" + locale + "/"}>
          Space360
        </a>
        ·{tx("Izrada sajta", "Website by")}
      </p>
    </footer>
    <script>
      const track = document.querySelector<HTMLElement>("[data-gallery]");
      const move = (direction: number) =>
        track?.scrollBy({
          left:
            direction * (track.querySelector("figure")?.getBoundingClientRect().width || 300) +
            direction * 20,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
        });
      document.querySelector("[data-gallery-prev]")?.addEventListener("click", () => move(-1));
      document.querySelector("[data-gallery-next]")?.addEventListener("click", () => move(1));
    </script>
  </body>
</html>
