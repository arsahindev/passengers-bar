---
import ReservationForm from "./ReservationForm.astro";
import { Image } from "astro:assets";
import { settings } from "../content/settings";
import logo from "../assets/passengers/logo.png";
import hero from "../assets/passengers/hero.jpg";
import room1 from "../assets/passengers/space-1.jpg";
import room2 from "../assets/passengers/space-2.jpg";
import room3 from "../assets/passengers/space-3.jpg";
import food1 from "../assets/passengers/food-1.jpg";
import food2 from "../assets/passengers/food-2.jpg";
import breakfastEN from "../assets/passengers/breakfast-en.png";
import breakfastSR from "../assets/passengers/breakfast-sr.jpg";
import offersEN from "../assets/passengers/offers-en.png";
import offersSR from "../assets/passengers/offers-sr.jpg";

const { locale = "en" } = Astro.props;
const sr = locale === "sr";
const tx = (serbian: string, english: string) => (sr ? serbian : english);

const gallery = [room1, room2, room3, food1, food2];
const menu = `/menus/passengers-menu-${sr ? "sr" : "en"}.pdf`;
const map =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent("Passengers Bar Simina 5 Belgrade");
---

<!doctype html>
<html lang={sr ? "sr-Latn" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#53272e" />
    <title>
      {tx("Passengers Bar", "Passengers Bar")}
    </title>
    <meta
      name="description"
      content={tx(
        "Passengers Bar u srcu Dorćola. Istražite prostor, pogledajte meni i kontaktirajte nas za rezervacije i proslave.",
        "Passengers Bar in the heart of Dorćol. Explore the space, browse the menu and get in touch for tables and celebrations.",
      )}
    />
  </head>
  <body data-locale={locale}>
    <a class="skip" href="#main">
      {tx("Pređi na sadržaj", "Skip to content")}
    </a>
    <header>
      <a class="wordmark" href="#main">
        <Image src={logo} width={66} height={66} alt="Passengers Bar" />
        <span>
          PASSENGERS<small>BAR · DORĆOL</small>
        </span>
      </a>
      <nav aria-label={tx("Glavna navigacija", "Main navigation")}>
        <a href="#story">{tx("Naše mesto", "Our place")}</a>
        <a href="#menu">{tx("Meni", "Menu")}</a>
        <a href="#celebrate">{tx("Proslave", "Celebrations")}</a>
        <a class="language" href={"/" + (sr ? "en" : "sr") + "/"}>
          {sr ? "EN" : "SR"}
        </a>
        <a class="btn small" href="#reserve">
          {tx("Rezervacije", "Reservations")}↗
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero">
        <Image
          src={hero}
          width={1600}
          format="webp"
          alt={tx("Bašta Passengers Bara", "Passengers Bar garden")}
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-shade"></div>
        <div class="hero-copy">
          <p class="eyebrow">SIMINA 5 · DORĆOL · BEOGRAD</p>
          <h1>
            {tx("Vaše mesto.", "Your kind")}
            <br />
            <em>{tx("U srcu Dorćola.", "of place.")}</em>
          </h1>
          <p>
            {tx(
              "Jutarnja kafa. Dugi ručkovi. Večeri koje ne planirate.",
              "Morning coffee. Long lunches. Evenings you didn’t plan.",
            )}
          </p>
          <div class="actions">
            <a class="btn cream" href="#reserve">
              {tx("Pronađite svoje mesto", "Find your table")}↗
            </a>
            <a href="#tour" class="text-link">
              {tx("Pogledajte prostor", "Explore the space")}↓
            </a>
          </div>
        </div>
        <div class="hero-bottom">
          <span>{tx("HRANA · PIĆE · DOBRO DRUŠTVO", "FOOD · DRINKS · GOOD COMPANY")}</span>
          <a href={map} target="_blank" rel="noopener noreferrer">
            {tx("Put do nas", "Get directions")}↗
          </a>
        </div>
      </section>
      <section id="story" class="section story">
        <div>
          <p class="eyebrow">{tx("MALO DALJE OD ŽURBE", "A LITTLE AWAY FROM THE RUSH")}</p>
          <h2>
            {tx("U centru grada.", "Right in the city.")}
            <br />
            <em>{tx("U svom ritmu.", "At your own pace.")}</em>
          </h2>
        </div>
        <div>
          <p class="lead">
            {tx(
              "Na uglu Simine i Višnjićeve, Passengers spaja druženje, hranu i baštu u kojoj se ostaje malo duže.",
              "On the corner of Simina and Višnjićeva, Passengers brings together food, conversation and a garden made for staying a little longer.",
            )}
          </p>
          <p>
            {tx(
              "Svratite na kafu, okupite prijatelje za ručak ili nam se javite da zajedno osmislimo proslavu.",
              "Drop in for coffee, gather your friends for lunch, or talk to us about your next celebration.",
            )}
          </p>
          <a class="underlined" href="#gallery">
            {tx("Zavirite unutra", "Take a look around")}↗
          </a>
        </div>
      </section>
      <section class="section gallery-section" id="gallery">
        <div class="section-head">
          <div>
            <p class="eyebrow">{tx("MESTO I TRENUTAK", "THE PLACE. THE MOMENT.")}</p>
            <h2>{tx("Osetite Passengers.", "A taste of Passengers.")}</h2>
          </div>
          <div class="gallery-controls">
            <button
              type="button"
              data-gallery-prev
              aria-label={tx("Prethodna fotografija", "Previous photograph")}
            >
              ←
            </button>
            <button
              type="button"
              data-gallery-next
              aria-label={tx("Sledeća fotografija", "Next photograph")}
            >
              →
            </button>
          </div>
        </div>
        <div class="gallery" tabindex="0" aria-label={tx("Galerija fotografija", "Photo gallery")}>
          {gallery.map((img, i) => (
            <figure>
              <>
                <Image
                  src={img}
                  width={850}
                  format="webp"
                  loading="lazy"
                  alt={tx(
                    i < 3 ? "Ambijent Passengers Bara" : "Hrana u Passengers Baru",
                    i < 3 ? "The setting at Passengers Bar" : "Food at Passengers Bar",
                  )}
                />
                <figcaption>
                  {String(i + 1).padStart(2, "0")} / 05 ·{" "}
                  {tx(
                    i < 3 ? "Naš prostor" : "Sa našeg stola",
                    i < 3 ? "Our space" : "From our table",
                  )}
                </figcaption>
              </>
            </figure>
          ))}
        </div>
      </section>
      <section class="menu-band" id="menu">
        <div>
          <p class="eyebrow">
            {tx("DOBRO JUTRO. DOBAR APETIT.", "GOOD MORNINGS. GOOD APPETITES.")}
          </p>
          <h2>{tx("Za svaki deo dana.", "Something for every part of the day.")}</h2>
          <p>
            {tx(
              "Pogledajte meni i pronađite svoj sledeći razlog za dolazak.",
              "Browse the menu and find your next reason to visit.",
            )}
          </p>
          <a class="btn cream" href={menu} target="_blank" rel="noopener noreferrer">
            {tx("Otvorite meni · PDF", "Open menu · PDF")}↗
          </a>
        </div>
        <Image
          src={food1}
          width={850}
          format="webp"
          loading="lazy"
          alt={tx("Jelo iz Passengers Bara", "A dish at Passengers Bar")}
        />
      </section>
      <section class="menu-reader" aria-label={tx("Pregled menija", "Menu viewer")}>
        <details>
          <summary>
            {tx("Pročitajte meni ovde", "Read the menu here")}
            <span aria-hidden="true">＋</span>
          </summary>
          <p>
            <a href={menu} target="_blank" rel="noopener noreferrer">
              {tx("Otvorite PDF u novom prozoru", "Open the PDF in a new tab")}↗
            </a>
          </p>
          <iframe
            src={menu}
            title={tx("Passengers Bar - meni na srpskom", "Passengers Bar - English menu")}
            loading="lazy"
          ></iframe>
        </details>
      </section>
      <section class="section celebrations" id="celebrate">
        <div class="celebrate-photo">
          <Image
            src={room2}
            width={850}
            format="webp"
            loading="lazy"
            alt={tx("Ambijent Passengers Bara", "Passengers Bar interior")}
          />
        </div>
        <div>
          <p class="eyebrow">{tx("VAŠ POVOD. NAŠ PROSTOR.", "YOUR OCCASION. OUR PLACE.")}</p>
          <h2>
            {tx("Okupite", "Bring everyone")}
            <br />
            <em>{tx("svoje ljude.", "together.")}</em>
          </h2>
          <p>
            {tx(
              "Rođendan, privatno okupljanje ili poslovni događaj. Recite nam šta planirate i kakav ambijent želite.",
              "A birthday, a private gathering or a work event. Tell us what you’re planning and the atmosphere you have in mind.",
            )}
          </p>
          <div class="facts">
            <span>{tx("Privatni događaji", "Private events")}</span>
            <span>{tx("Prostor uz baštu", "Garden-side setting")}</span>
            <span>{tx("Dogovor prema povodu", "Plans tailored to the occasion")}</span>
          </div>
          <a class="btn" href="#reserve" data-event-link>
            {tx("Upit za proslavu", "Plan a celebration")}↗
          </a>
        </div>
      </section>
      {settings.tourEmbedUrl && (
        <section class="tour-section" id="tour">
          <div class="section-head">
            <div>
              <p class="eyebrow">
                360°{settings.tourIsSample ? tx(" · Primer ture", " · Sample tour") : ""}
              </p>
              <h2>{tx("Pogledajte prostor.", "Take a look around.")}</h2>
            </div>
            <p>
              {tx(
                "Pronađite svoj omiljeni kutak pre dolaska.",
                "Find your favourite corner before you visit.",
              )}
            </p>
          </div>
          <iframe
            src={settings.tourEmbedUrl}
            title={
              settings.tourIsSample
                ? tx("Primer virtuelne ture stana", "Sample apartment virtual tour")
                : tx("Virtuelna tura Passengers Bara", "Passengers Bar virtual tour")
            }
            width="100%"
            height="500"
            loading="lazy"
            allow="autoplay; fullscreen; gyroscope; accelerometer; xr-spatial-tracking"
            allowfullscreen
          ></iframe>
        </section>
      )}
      <section class="section promotions" id="offers">
        <div class="section-head">
          <div>
            <p class="eyebrow">{tx("AKTUELNO", "WHAT’S ON")}</p>
            <h2>{tx("Mali razlozi za dolazak.", "A few more reasons to visit.")}</h2>
          </div>
          <p class="review-note">
            {tx(
              "Za aktuelne ponude i uslove obratite se našem timu.",
              "Ask our team about current offers and availability.",
            )}
          </p>
        </div>
        <div class="poster-grid">
          <figure>
            <Image
              src={sr ? breakfastSR : breakfastEN}
              width={1100}
              format="webp"
              loading="lazy"
              alt={tx(
                "Doručak: uz doplatu od 250 RSD kafa i ceđeni miks uz bilo koji doručak. Proverite aktuelnu ponudu sa osobljem.",
                "Breakfast: add coffee and freshly squeezed mixed juice for RSD 250. Offer subject to confirmation.",
              )}
            />
            <figcaption>{tx("Doručak", "Breakfast")}</figcaption>
          </figure>
          <figure>
            <Image
              src={sr ? offersSR : offersEN}
              width={1100}
              format="webp"
              loading="lazy"
              alt={tx(
                "Akcije: 4+1 burger gratis; nedelja–četvrtak 25% na određena pića; uz ručak 14–16h jedno piće po izboru. Proverite uslove sa osobljem.",
                "Offers: buy four burgers, get one free; Sunday–Thursday 25% off selected drinks; lunch 14–16 includes a drink from the listed selection. Terms subject to confirmation.",
              )}
            />
            <figcaption>{tx("Ponude", "Offers")}</figcaption>
          </figure>
        </div>
      </section>
      <section class="reserve-section" id="reserve">
        <div>
          <p class="eyebrow">{tx("NAPRAVITE PLAN", "MAKE A PLAN")}</p>
          <h2>
            {tx("Vidimo se", "See you")}
            <br />
            <em>{tx("za stolom.", "at the table.")}</em>
          </h2>
          <p>
            {tx(
              "Planirate dolazak ili proslavu? Javite nam željeni datum, vreme i broj gostiju.",
              "Planning a visit or a celebration? Tell us your preferred date, time and number of guests.",
            )}
          </p>
        </div>
        <div>
          <ReservationForm locale={locale} />
        </div>
      </section>
      <section class="section visit" id="visit">
        <div>
          <p class="eyebrow">{tx("DORĆOL VAS ČEKA", "DORĆOL IS CALLING")}</p>
          <h2>
            Simina 5.
            <br />
            <em>{tx("Svratite.", "Come by.")}</em>
          </h2>
          <p>Simina 5, Beograd</p>
          <p>
            {tx("Pon–čet", "Mon–Thu")}08:30–00:00
            <br />
            {tx("Pet–sub", "Fri–Sat")}08:30–01:00
            <br />
            {tx("Nedelja", "Sunday")}09:00–00:00
          </p>
          <div class="actions">
            <a class="btn" href={map} target="_blank" rel="noopener noreferrer">
              Google Maps ↗
            </a>
            <a
              class="underlined"
              href="https://www.instagram.com/passengers_bar/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram ↗
            </a>
          </div>
        </div>
        <div class="location-card">
          <span class="compass" aria-hidden="true">
            ↗
          </span>
          <p class="eyebrow">SIMINA × VIŠNJIĆEVA</p>
          <h3>
            {tx("Na uglu.", "On the corner.")}
            <br />
            {tx("U komšiluku.", "In the neighbourhood.")}
          </h3>
          <a href={map} target="_blank" rel="noopener noreferrer">
            {tx("Otvorite tačnu lokaciju u Google Maps", "Open the location in Google Maps")}↗
          </a>
        </div>
      </section>
    </main>
    <footer>
      <div class="wordmark">
        PASSENGERS<small>BAR · DORĆOL</small>
      </div>
      <p>
        {tx("Simina 5 · Dorćol · Beograd", "Simina 5 · Dorćol · Belgrade")}
        <br />
        <a href={settings.origin + "/" + locale + "/"}>Space360</a>·
        {tx("Izrada sajta", "Website by")}
      </p>
    </footer>
    <script>
      const track = document.querySelector<HTMLElement>(".gallery");
      const move = (direction: number) =>
        track?.scrollBy({
          left:
            direction * (track.querySelector("figure")?.getBoundingClientRect().width || 300) +
            direction * 20,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
        });
      document.querySelector("[data-gallery-prev]")?.addEventListener("click", () => move(-1));
      document.querySelector("[data-gallery-next]")?.addEventListener("click", () => move(1));
    </script>
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap");
      .menu-reader {
        padding: 24px max(6vw, 20px);
        background: #53272e;
        color: #f7f4ee;
      }
      .menu-reader details {
        max-width: 1280px;
        margin: 0 auto;
      }
      .menu-reader summary {
        cursor: pointer;
        font-size: 1.1rem;
        padding: 12px 0;
      }
      .menu-reader summary span {
        float: right;
      }
      .menu-reader a {
        text-decoration: underline;
      }
      .menu-reader iframe {
        display: block;
        width: 100%;
        height: min(80vh, 900px);
        min-height: 400px;
        border: 0;
        border-radius: 8px;
        background: #f7f4ee;
      }

      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 110px;
      }
      body {
        margin: 0;
        background: #f7f4ee;
        color: #2f2e28;
        font:
          16px/1.6 "DM Sans",
          sans-serif;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button,
      input,
      select,
      textarea {
        font: inherit;
      }
      button,
      a,
      input,
      select,
      textarea {
        -webkit-tap-highlight-color: transparent;
      }
      button {
        cursor: pointer;
      }
      img {
        display: block;
        max-width: 100%;
      }
      h1,
      h2,
      h3,
      p,
      figure {
        margin: 0;
      }
      h1,
      h2,
      h3 {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 500;
        line-height: 1.06;
      }
      h2 {
        font-size: clamp(2.5rem, 4vw, 4.2rem);
        letter-spacing: -0.045em;
      }
      h3 {
        font-size: 2rem;
      }
      p + p {
        margin-top: 18px;
      }
      em {
        font-weight: 500;
      }
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible {
        outline: 3px solid #d98b56;
        outline-offset: 5px;
      }
      .skip {
        position: absolute;
        left: 10px;
        top: -80px;
        background: white;
        padding: 10px;
        z-index: 100;
      }
      .skip:focus {
        top: 0;
      }
      .preview-banner {
        background: #3b4a3d;
        color: #fff;
        font-size: 11px;
        text-align: center;
        letter-spacing: 0.06em;
        padding: 10px;
      }
      .preview-banner a {
        text-decoration: underline;
        margin-left: 14px;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 5%;
        gap: 24px;
        background: #f7f4ee;
      }
      .wordmark {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 19px;
        letter-spacing: 0.15em;
        font-weight: 700;
      }
      .wordmark small {
        display: block;
        font-size: 9px;
        letter-spacing: 0.22em;
      }
      nav {
        display: flex;
        align-items: center;
        gap: 28px;
        font-size: 13px;
      }
      nav > a:not(.btn):hover {
        text-decoration: underline;
      }
      .language {
        font-weight: 700;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 25px;
        border: 1px solid #53272e;
        background: #53272e;
        color: white;
        padding: 15px 24px;
        border-radius: 2px;
        font-size: 13px;
        font-weight: 600;
      }
      .btn:hover {
        filter: brightness(1.13);
      }
      .btn.small {
        padding: 12px 18px;
      }
      .btn.cream {
        background: #f7f4ee;
        border-color: #f7f4ee;
        color: #422730;
      }
      .hero {
        height: min(770px, 80vh);
        min-height: 540px;
        position: relative;
        background: #382e28;
        color: white;
      }
      .hero > img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
      .hero-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, #101910bb 0%, #10191055 58%, #10191022);
      }
      .hero-copy {
        position: absolute;
        left: 8%;
        top: 15%;
        max-width: 770px;
      }
      .eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.22em;
        margin-bottom: 25px;
      }
      .hero h1 {
        font-size: clamp(4.7rem, 8vw, 8.5rem);
        letter-spacing: -0.045em;
      }
      .hero-copy > p:not(.eyebrow) {
        margin-top: 25px;
      }
      .actions {
        display: flex;
        gap: 25px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 30px;
      }
      .text-link,
      .underlined {
        text-decoration: underline;
        text-underline-offset: 6px;
        font-size: 13px;
      }
      .hero-bottom {
        position: absolute;
        bottom: 30px;
        left: 8%;
        right: 8%;
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        letter-spacing: 0.12em;
      }
      .section {
        max-width: 1400px;
        margin: auto;
        padding: 95px 8%;
      }
      .story,
      .celebrations,
      .visit {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 90px;
        align-items: center;
      }
      .story .lead {
        font-size: 20px;
        line-height: 1.65;
      }
      .story .underlined {
        display: inline-block;
        margin-top: 24px;
      }
      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 45px;
        margin-bottom: 35px;
      }
      .section-head > p {
        max-width: 340px;
      }
      .gallery-section {
        padding-top: 10px;
      }
      .gallery-controls {
        display: flex;
        gap: 10px;
      }
      .gallery-controls button {
        border: 1px solid #b5b4a8;
        border-radius: 50%;
        width: 44px;
        height: 44px;
        background: transparent;
        font-size: 22px;
      }
      .gallery {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 15px;
      }
      .gallery figure {
        flex: 0 0 42%;
        scroll-snap-align: start;
      }
      .gallery img {
        width: 100%;
        height: 380px;
        object-fit: cover;
      }
      .gallery figcaption {
        font-size: 10px;
        letter-spacing: 0.15em;
        margin-top: 15px;
      }
      .review-note {
        font-size: 11px;
        opacity: 0.75;
        margin-top: 18px !important;
        line-height: 1.7;
      }
      .menu-band {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #53272e;
        color: #f7f4ee;
      }
      .menu-band > div {
        padding: 85px 16%;
      }
      .menu-band > img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        max-height: 660px;
      }
      .menu-band p:not(.eyebrow) {
        margin-top: 24px;
      }
      .menu-band .btn {
        margin-top: 25px;
      }
      .celebrate-photo img {
        height: 570px;
        width: 100%;
        object-fit: cover;
      }
      .celebrations h2 + p {
        margin-top: 25px;
      }
      .facts {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 25px 0 30px;
