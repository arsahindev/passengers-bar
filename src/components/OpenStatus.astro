---
// Live "open / closed" line from the opening hours in settings.ts, e.g. "Otvoreno · do 01:00" or
// "Zatvoreno · otvaramo u 08:30". Filled in on the visitor's device for the current Belgrade time
// (src/scripts/open-status.ts); hidden without JavaScript. With href it renders as a link with a
// down arrow (to the full hours). Style it with statusPillDark / statusPillLight from ui.ts.
import { settings } from "../content/settings";
import Icon from "./Icon.astro";
import { useLocale } from "../lib/i18n";

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props as Props;
const { tx } = useLocale(Astro.currentLocale);
const Tag = href ? "a" : "span";
const hours = settings.hours.map(({ days, open, close }) => ({ days, open, close }));
---

<Tag
  href={href}
  class={className}
  data-open-status
  data-hours={JSON.stringify(hours)}
  data-open={tx("Otvoreno · do {time}", "Open · until {time}")}
  data-opens-today={tx("Zatvoreno · otvaramo u {time}", "Closed · opens at {time}")}
  data-opens-tomorrow={tx(
    "Zatvoreno · otvaramo sutra u {time}",
    "Closed · opens tomorrow at {time}",
  )}
  data-closed={tx("Zatvoreno", "Closed")}
  hidden
>
  <span
    class="size-[.65em] shrink-0 animate-pulse rounded-full bg-[#8fd19e] shadow-[0_0_0_3px_rgba(143,209,158,.25)] motion-reduce:animate-none"
    data-open-dot
    hidden
  ></span>
  <span class="size-[.65em] shrink-0 rounded-full bg-ember" data-closed-dot hidden></span>
  <span data-open-text></span>
  {href && <Icon name="arrow-down" class="opacity-70" />}
</Tag>
<script>
  import "../scripts/open-status";
</script>
